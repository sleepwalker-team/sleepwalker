script: python train_breathing.py
args:
    pap: {{ True || False }}
    scaler: {{ True || False }}
    apnea_weight: {{ 1 || 2 || 5 }}
    hypopnea_weight: {{ 1 || 2 || 5 }}
    channels: {{
        ["RIP Flow", "RIP Sum", "Chest", "Abdomen", "Saturation"] ||
        ["RIP Flow Cal", "RIP Sum Cal", "Chest", "Abdomen", "Saturation"] ||
        ["RIP Flow", "RIP Sum", "Chest", "Abdomen", "RIP-Phase", "Resp Rate", "Saturation", "Pulse Waveform"]
    }}
    model: {{ "utime-small" || "utime-huge" || "utime-big" }}
    total_input: {{ "60s" || "80s" || "120s" || "240s" }}
