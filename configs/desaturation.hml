script: python train_desaturation.py
args:
    channels: {{ 
        ["Chest", "Abdomen", "Saturation", "Pulse Waveform"] || 
        ["Saturation", "Pulse Waveform"] ||
        ["Saturation"] ||
        ["Chest", "Abdomen", "Saturation"]
    }}
    scaler: {{ True || False }}
    desaturation_weight: {{ 1 || 3 || 5 }}
    model: {{ "utime-big" || "utime-small" }}
    sleep_percentage: {{ 0 || 0.25 || 0.5}}
    stride: {{ 1s || 2s}}
    target_resolution: {{ "5s" || "10s" || "20s" }}
    total_input: {{"60s" || "100s" || "120s" }}
    epochs: 75